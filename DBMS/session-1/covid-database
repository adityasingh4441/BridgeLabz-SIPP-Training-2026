-- 1. CREATE COVID DATABASE SCHEMA

CREATE DATABASE IF NOT EXISTS covid_db;
USE covid_db;

-- Table: covid_cases
CREATE TABLE covid_cases (
    country VARCHAR(50),
    report_date DATE,
    confirmed_cases INT,
    deaths INT,
    recoveries INT,
    population BIGINT
);

-- Table: covid_deaths
CREATE TABLE covid_deaths (
    country VARCHAR(50),
    report_date DATE,
    total_deaths INT,
    new_deaths INT
);

-- Table: covid_vaccines
CREATE TABLE covid_vaccines (
    country VARCHAR(50),
    report_date DATE,
    total_vaccinated INT,
    fully_vaccinated INT,
    booster_doses INT
);



