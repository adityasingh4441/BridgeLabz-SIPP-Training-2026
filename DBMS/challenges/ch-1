Create COVID Database Schema

CREATE DATABASE covid_db;
USE covid_db;


CREATE TABLE covid_cases (
    id INT AUTO_INCREMENT PRIMARY KEY,
    country VARCHAR(100),
    report_date DATE,
    report_time TIME,
    recovered_cases INT,
    death_cases INT,
    confirmed_cases INT
);


